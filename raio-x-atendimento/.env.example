# Copie para .env e preencha. Nunca coloque o .env no Git.

# Endereço público desta aplicação (domínio com HTTPS em produção). Usado nos links dos corretores e no webhook.
URL_PUBLICA=https://raiox.suaimobiliaria.com.br

# Acesso ao painel do gestor (/gestor)
GESTOR_USUARIO=gestor
GESTOR_SENHA=troque-por-uma-senha-forte

# Chave da API da Anthropic (console.anthropic.com). Sem ela, a análise é SIMULADA (só demonstração).
ANTHROPIC_API_KEY=

# Modelos de IA. A análise usa o modelo mais capaz; a triagem (cliente x pessoal) pode usar um mais barato,
# por exemplo claude-haiku-5-5, se o custo pesar.
MODELO_ANALISE=claude-opus-5-5
MODELO_TRIAGEM=claude-opus-5-5

# Evolution API (conexão com o WhatsApp). No docker-compose ela já sobe junto.
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
WEBHOOK_SEGREDO=troque-por-outro-segredo-aleatorio

# Senha do Postgres (usada pelo docker-compose)
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# Ajustes opcionais
# ANALISE_CONCORRENCIA=4          # análises em paralelo
# ANALISE_ESPERA_MINUTOS=30       # espera a conversa parar antes de analisar
# ANALISE_MINIMO_NOVAS=3          # reanalisa após N mensagens novas
# FOLLOWUP_HORAS=24               # cliente parado há mais que isso entra em "Retome hoje"
# RESUMO_DIARIO_HORA=8            # hora do resumo no WhatsApp do corretor (horário de Brasília)
