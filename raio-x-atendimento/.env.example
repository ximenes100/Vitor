# Copie para .env e preencha. Nunca coloque o .env no Git.

# Endereço público desta aplicação (domínio com HTTPS em produção). Usado nos links dos corretores e no webhook.
URL_PUBLICA=https://raiox.suaimobiliaria.com.br

# Acesso ao painel do gestor (/gestor)
GESTOR_USUARIO=gestor
GESTOR_SENHA=troque-por-uma-senha-forte

# Chave da API da Anthropic (console.anthropic.com). Sem ela, a análise é SIMULADA (só demonstração).
ANTHROPIC_API_KEY=

# Marco de uso de IA pelo time: as semanas a partir desta data contam como "depois".
MARCO_IA=2026-11-01
# Quantas semanas antes do marco analisar como linha de base ("antes").
SEMANAS_LINHA_DE_BASE=12

# Modelos de IA: triagem e análise de cada conversa usam o modelo econômico;
# os relatórios semanais (poucos e importantes) usam o mais capaz.
MODELO_TRIAGEM=claude-haiku-5-5
MODELO_ANALISE=claude-haiku-5-5
MODELO_RELATORIO=claude-opus-5-5
# Processamento em lote: metade do preço, resultado em algumas horas. Use "nao" para testes rápidos.
USAR_LOTE=sim

# Evolution API (conexão com o WhatsApp). No docker-compose ela já sobe junto.
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
WEBHOOK_SEGREDO=troque-por-outro-segredo-aleatorio

# Senha do Postgres (usada pelo docker-compose)
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# Ajustes opcionais
# RELATORIO_SEMANAL_HORA=8        # hora de segunda-feira em que o relatório vai para o WhatsApp do corretor
# RESUMO_DIARIO_HORA=8            # lembrete diário "clientes esperando resposta" (não usa IA)
# FOLLOWUP_HORAS=24               # cliente parado há mais que isso entra em "Retome hoje"
# ANALISE_CONCORRENCIA=4          # chamadas diretas em paralelo
# ANALISE_MENSAGENS_CONTEXTO=30   # mensagens de semanas anteriores enviadas como contexto
